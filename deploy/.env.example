# Only Memrly. Never reuse GeoCauce passwords or credentials.
# Generate two DISTINCT random secrets with: openssl rand -hex 32
MEMRLY_DB_NAME=memrly
MEMRLY_DB_USER=memrly
MEMRLY_DB_PASSWORD=REPLACE_WITH_UNIQUE_LONG_SECRET
MEMRLY_JWT_SECRET=REPLACE_WITH_ANOTHER_DIFFERENT_SECRET_64_HEX_CHARS
MEMRLY_ALLOW_SIGNUP=false
MEMRLY_MAX_UPLOAD_BYTES=26214400
